{
  "description": "Baton-owned Codex mutation guard. Review and trust it from /hooks.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "baton guard hook",
            "timeout": 30,
            "statusMessage": "Checking Baton host guard"
          }
        ]
      }
    ]
  }
}
