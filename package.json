{
  "name": "@zhouliuya/openbaton",
  "version": "0.2.0",
  "description": "CLI-neutral director for Codex and Grok: automatic model routing, native subagents, mechanical ops, and a clean main context. Standalone; OpenSpec optional.",
  "type": "module",
  "bin": {
    "baton": "dist/bin/baton.js"
  },
  "engines": {
    "node": ">=22.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lilinxiong/openbaton.git"
  },
  "homepage": "https://github.com/lilinxiong/openbaton#readme",
  "bugs": {
    "url": "https://github.com/lilinxiong/openbaton/issues"
  },
  "author": "zhouliuya",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json && node -e \"require('node:fs').chmodSync('dist/bin/baton.js',0o755)\"",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run check && bun test --timeout 30000 test/*.test.ts",
    "compare-ops": "bun scripts/compare-mechanical-ops.ts",
    "baton": "bun bin/baton.ts",
    "prepack": "npm run build"
  },
  "files": [
    "dist",
    "data",
    "docs/data-sources",
    "samples",
    "templates",
    "SKILL.md",
    "LICENSE",
    "README.md",
    "README.zh.md"
  ],
  "keywords": [
    "baton",
    "openbaton",
    "director",
    "openspec",
    "multi-model"
  ],
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
