{
  "name": "baton",
  "version": "0.1.0",
  "description": "Director for multi-model work. 既能独立，又能 1+1>2 — complete standalone; strictly better with OpenSpec.",
  "type": "module",
  "bin": {
    "baton": "dist/bin/baton.js"
  },
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && node -e \"require('node:fs').chmodSync('dist/bin/baton.js',0o755)\"",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run check && tsx --test test/*.test.ts",
    "baton": "tsx bin/baton.ts",
    "prepack": "npm run build"
  },
  "files": [
    "dist",
    "data",
    "docs/data-sources",
    "samples",
    "templates",
    "SKILL.md",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "baton",
    "director",
    "openspec",
    "multi-model"
  ],
  "license": "MIT",
  "dependencies": {
    "@bitkyc08/opencodex": "^2.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
