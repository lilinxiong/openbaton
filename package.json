{
  "name": "@zhouliuya/openbaton",
  "version": "1.0.0",
  "description": "Manifest-driven, CLI-neutral scheduler with a public adapter SDK, native execution lifecycle, and scoped ticket orchestration.",
  "type": "module",
  "bin": {
    "baton": "dist/bin/baton.js"
  },
  "exports": {
    ".": "./dist/src/index.js",
    "./adapters": "./dist/src/adapters/sdk.js",
    "./adapters/sdk": "./dist/src/adapters/sdk.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lilinxiong/openbaton.git"
  },
  "homepage": "https://github.com/lilinxiong/openbaton#readme",
  "bugs": {
    "url": "https://github.com/lilinxiong/openbaton/issues"
  },
  "author": "zhouliuya",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json && node -e \"require('node:fs').chmodSync('dist/bin/baton.js',0o755)\"",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run check && bun test --timeout 30000 test/*.test.ts",
    "baton": "bun bin/baton.ts",
    "prepack": "npm run build"
  },
  "files": [
    "adapters",
    "dist",
    "docs",
    "samples",
    "templates",
    "SKILL.md",
    "LICENSE",
    "README.md",
    "README.zh.md"
  ],
  "keywords": [
    "baton",
    "openbaton",
    "director",
    "adapter-sdk",
    "scheduling",
    "native-execution",
    "task-orchestration"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
