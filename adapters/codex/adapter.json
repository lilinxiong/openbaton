{
  "schema": 1,
  "adapter": {
    "id": "codex",
    "display_name": "Codex",
    "package_name": "@zhouliuya/openbaton-codex-adapter",
    "package_version": "2.0.0",
    "sdk_version": "1.0"
  },
  "catalog": {
    "command": "catalog.mjs",
    "args": [],
    "protocol": "json",
    "timeout_ms": 30000
  },
  "invocation": {
    "signal": "CODEX_THREAD_ID",
    "environment": "Codex Desktop thread runtime"
  },
  "subagent_test": {
    "command": "test-subagents.mjs",
    "args": [],
    "timeout_ms": 180000
  },
  "native": {
    "execution_handle_kind": "task_name"
  },
  "runtime_skill": {
    "source": "runtime/SKILL.md",
    "destination": ".codex/skills/baton/SKILL.md"
  },
  "quota": {
    "max_depth": 1,
    "backpressure": "defer"
  }
}
